# ===================================
# ملف إعدادات البيئة - Tourfecto Platform
# ===================================

# إعدادات التطبيق
APP_NAME="Tourfecto"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Riyadh
APP_LOCALES=en,ar,es,fr,de,it,pt,ru,zh,ja,ko,tr,hi,ur,fa
APP_FALLBACK_LOCALE=en

# قاعدة البيانات
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tourfecto_db
DB_USERNAME=tourfecto_user
DB_PASSWORD=TourfectoPass@2024

# البريد الإلكتروني
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# الذكاء الاصطناعي
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# الدفع
STRIPE_KEY=your-stripe-key
PAYPAL_CLIENT_ID=your-paypal-id
FAWRY_MERCHANT_CODE=your-fawry-code
MADA_MERCHANT_ID=your-mada-id

# وسائل التواصل
TELEGRAM_BOT_TOKEN=your-telegram-token
TWITTER_API_KEY=your-twitter-key
FACEBOOK_APP_SECRET=your-facebook-secret

# الأمان
JWT_SECRET=generate-random-32-chars-here
ENCRYPTION_KEY=generate-random-32-chars-here
